<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.CitizenHomeController"
            fitToWidth="true"
            styleClass="citizen-scroll"
            stylesheets="@../css/citizen-home.css">
    <VBox spacing="20" styleClass="citizen-page">
        <padding>
            <Insets top="30" right="32" bottom="32" left="32"/>
        </padding>

        <HBox alignment="CENTER_LEFT">
            <VBox spacing="5">
                <Label fx:id="welcomeLabel" text="Olá!" styleClass="citizen-title"/>
                <Label text="Acompanhe suas solicitações e ajude a melhorar a cidade."
                       styleClass="citizen-subtitle"/>
            </VBox>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="+ Nova reclamação"
                    onAction="#newComplaint"
                    styleClass="primary-action"/>
        </HBox>

        <HBox spacing="16">
            <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                <Label text="REGISTRADAS POR VOCÊ" styleClass="summary-name"/>
                <Label fx:id="totalLabel" text="0" styleClass="summary-value"/>
            </VBox>
            <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                <Label text="PENDENTES" styleClass="summary-name"/>
                <Label fx:id="pendingLabel" text="0" styleClass="summary-value pending-value"/>
            </VBox>
            <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                <Label text="EM ANDAMENTO" styleClass="summary-name"/>
                <Label fx:id="inProgressLabel" text="0" styleClass="summary-value progress-value"/>
            </VBox>
            <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                <Label text="RESOLVIDAS" styleClass="summary-name"/>
                <Label fx:id="resolvedLabel" text="0" styleClass="summary-value resolved-value"/>
            </VBox>
        </HBox>

        <VBox spacing="14" styleClass="urgent-ranking-section">
            <VBox spacing="3">
                <Label text="Top 3 reclamações mais urgentes"
                       styleClass="urgent-ranking-title"/>
                <Label text="Problemas recorrentes da cidade ordenados por prioridade de atendimento."
                       styleClass="urgent-ranking-subtitle"/>
            </VBox>
            <HBox fx:id="urgentRankingContainer"
                  spacing="12"
                  alignment="TOP_LEFT"/>
        </VBox>

        <VBox spacing="14" styleClass="content-card" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="3">
                    <Label text="Atividades recentes" styleClass="section-title"/>
                    <Label text="Suas últimas reclamações registradas."
                           styleClass="section-subtitle"/>
                </VBox>
                <Pane HBox.hgrow="ALWAYS"/>
            </HBox>
            <ListView fx:id="recentList"
                      prefHeight="290"
                      VBox.vgrow="ALWAYS"/>
        </VBox>

        <VBox spacing="6" styleClass="help-card">
            <Label text="Como funciona?" styleClass="help-title"/>
            <Label wrapText="true"
                   text="Registre o problema informando categoria, prioridade, descrição e localização. A equipe responsável acompanhará sua solicitação e você poderá consultar o histórico de cada alteração."
                   styleClass="help-text"/>
        </VBox>
    </VBox>
</ScrollPane>
