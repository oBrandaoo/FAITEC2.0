<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controller.complaint.ComplaintFormController"
           stylesheets="@../css/common.css,@../css/complaint.css">

    <VBox alignment="CENTER">

        <VBox spacing="15"
              alignment="TOP_LEFT"
              styleClass="card"
              maxWidth="420">

            <Label text="Registrar Reclamação"
                   styleClass="title"/>

            <Label text="Informe os dados abaixo para registrar o problema."
                   wrapText="true"
                   styleClass="subtitle"/>

            <VBox spacing="5">
                <Label text="Categoria"/>
                <ComboBox fx:id="categoryBox"
                          prefWidth="360"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Prioridade"/>
                <ComboBox fx:id="priorityBox"
                          prefWidth="360"/>
            </VBox>

            <VBox spacing="5">

                <Label text="Local"/>

                <HBox spacing="8">
                    <TextField fx:id="addressField"
                               promptText="Digite um endereço em Santa Rita do Sapucaí"
                               onAction="#searchAddress"
                               HBox.hgrow="ALWAYS"/>

                    <Button fx:id="searchAddressButton"
                            text="Buscar"
                            onAction="#searchAddress"/>
                </HBox>

                <Button text="📍 Selecionar no mapa"
                        onAction="#selectLocation"/>

            </VBox>

            <VBox spacing="5">
                <Label text="Descrição"/>
                <TextArea fx:id="descriptionArea"
                          promptText="Descreva o problema encontrado..."
                          prefRowCount="5"
                          wrapText="true"
                          prefWidth="360"/>
            </VBox>

            <VBox spacing="7">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2">
                        <Label text="Fotos"/>
                        <Label text="Até 4 imagens PNG ou JPEG, com 5 MB cada."
                               styleClass="attachment-hint"/>
                    </VBox>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button text="Adicionar fotos"
                            onAction="#chooseAttachments"/>
                </HBox>
                <FlowPane fx:id="attachmentPreview"
                          hgap="8" vgap="8"
                          prefWrapLength="360"/>
            </VBox>

            <HBox spacing="10"
                  alignment="CENTER_RIGHT">

                <Button text="Voltar"
                        styleClass="secondary-button"
                        onAction="#goStart"/>

                <Button text="Enviar"
                        styleClass="primary-button"
                        onAction="#submitComplaint"/>

            </HBox>

        </VBox>

    </VBox>

</StackPane>
