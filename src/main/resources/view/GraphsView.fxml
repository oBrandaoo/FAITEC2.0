<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.GraphsController"
            fx:id="rootPane">
    <left>
        <VBox spacing="10"
              style="-fx-background-color: #2c3e50; -fx-padding: 10;"
              prefWidth="150">

            <Label text="Menu" style="-fx-text-fill: white;"/>

            <Button text="Gráficos"/>
            <Button text="Minhas Reclamações"/>
            <Button text="Configurações"/>
            <Button text="Voltar"
                    onAction="#seeComplaints"/>
        </VBox>
    </left>
</BorderPane>