<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controller.complaint.ComplaintListController"
           stylesheets="@../css/common.css,@../css/complaint.css">

    <VBox alignment="CENTER">

        <VBox spacing="18"
              maxWidth="980"
              styleClass="card">

            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <Label text="Lista de Reclamações"
                   styleClass="title"/>

            <Label text="Acompanhe o andamento das reclamações registradas."
                   styleClass="subtitle"/>

            <HBox spacing="12" alignment="CENTER_LEFT">

                <TextField fx:id="searchField"
                           promptText="Pesquisar reclamação..."
                           HBox.hgrow="ALWAYS"/>

                <ComboBox fx:id="categoryFilter"
                          promptText="Categoria"
                          prefWidth="170"/>

                <ComboBox fx:id="statusFilter"
                          promptText="Status"
                          prefWidth="140"/>

                <ComboBox fx:id="priorityFilter"
                          promptText="Prioridade"
                          prefWidth="130"/>

                <Button text="Limpar"
                        onAction="#clearFilters"/>

                <Button text="Exportar CSV"
                        onAction="#exportCsv"/>

            </HBox>

            <TableView fx:id="complaintsTable"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="categoryColumn"
                                 text="Categoria"
                                 prefWidth="140"/>

                    <TableColumn fx:id="priorityColumn"
                                 text="Prioridade"
                                 prefWidth="100"/>

                    <TableColumn fx:id="locationColumn"
                                 text="Local"
                                 prefWidth="160"/>

                    <TableColumn fx:id="descriptionColumn"
                                 text="Descrição"
                                 prefWidth="250"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="100"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Data"
                                 prefWidth="120"/>

                    <TableColumn fx:id="actionColumn"
                                 text="Ações"
                                 prefWidth="120"/>
                </columns>

            </TableView>

        </VBox>

    </VBox>

</StackPane>
