<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainRoot"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.MainController"
            stylesheets="@../css/main.css,@../css/accessibility.css">

    <left>

        <VBox prefWidth="260"
              spacing="18"
              styleClass="sidebar">

            <padding>
                <Insets top="25" right="18" bottom="20" left="18"/>
            </padding>

            <HBox spacing="12" alignment="CENTER_LEFT">

                <StackPane>
                    <ImageView fitWidth="50"
                               preserveRatio="true"
                               smooth="true">
                        <image>
                            <Image url="@../images/logoSemNome.png"/>
                        </image>
                    </ImageView>
                </StackPane>

                <VBox spacing="2">

                    <Label text="Cidade em Dia"
                           styleClass="logo"/>

                    <Label text="Gestão de Reclamações"
                           styleClass="logoSubtitle"/>

                </VBox>

            </HBox>

            <Separator styleClass="separator"/>

            <Label text="NAVEGAÇÃO"
                   styleClass="sectionTitle"/>

            <Button text="🏠   Início"
                    accessibleText="Início. Atalho Alt mais 1"
                    onAction="#goHome"
                    styleClass="menuButton"/>

            <Button text="📝   Nova Reclamação"
                    accessibleText="Nova reclamação. Atalho Alt mais 2"
                    fx:id="newComplaintButton"
                    onAction="#goComplaint"
                    styleClass="menuButton"/>

            <Button text="📋   Reclamações"
                    accessibleText="Lista de reclamações. Atalho Alt mais 3"
                    fx:id="complaintsButton"
                    onAction="#goComplaints"
                    styleClass="menuButton"/>

            <Button text="🗺   Mapa"
                    accessibleText="Mapa de reclamações. Atalho Alt mais 4"
                    fx:id="mapButton"
                    onAction="#goMap"
                    styleClass="menuButton"/>

            <Pane VBox.vgrow="ALWAYS"/>

            <Separator styleClass="separator"/>

            <Button text="⚙   Configurações"
                    accessibleText="Configurações e acessibilidade. Atalho Alt mais 5"
                    onAction="#goSettings"
                    styleClass="menuButton"/>

            <Button text="ⓘ   Sobre o sistema"
                    accessibleText="Sobre o sistema. Atalho Alt mais zero"
                    onAction="#goAbout"
                    styleClass="menuButton"/>

            <VBox spacing="2">
                <Label fx:id="loggedUserLabel"
                       text="Usuário"
                       styleClass="footerTitle"/>
                <Label fx:id="loggedUserRoleLabel"
                       text="Perfil"
                       styleClass="footer"/>
            </VBox>

            <VBox spacing="3">

                <Label text="Sistema Cidade em Dia"
                       styleClass="footerTitle"/>

                <Label text="Versão 1.0"
                       styleClass="footer"/>

            </VBox>

        </VBox>

    </left>

    <center>

        <StackPane styleClass="content">
            <StackPane fx:id="contentArea"/>
            <VBox fx:id="toastLayer"
                  spacing="10"
                  mouseTransparent="true"
                  pickOnBounds="false"
                  maxWidth="380"
                  StackPane.alignment="TOP_RIGHT">
                <padding>
                    <Insets top="22" right="22" bottom="22" left="22"/>
                </padding>
            </VBox>
        </StackPane>

    </center>

</BorderPane>
